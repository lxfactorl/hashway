{
  "name": "hashway",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox WebExtension for sending torrent intents to Real-Debrid (hello-world setup phase).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=25.0.0 <26.0.0"
  },
  "engineStrict": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:property": "vitest run --dir tests/property",
    "test:coverage": "vitest run --coverage",
    "build": "wxt build",
    "test:manifest": "vitest run --dir tests/unit manifest-contract",
    "web-ext:lint": "web-ext lint --source-dir dist",
    "test:e2e": "vitest run --dir tests/e2e"
  },
  "devDependencies": {
    "wxt": "0.21.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "fast-check": "4.0.0",
    "eslint": "10.0.0",
    "typescript-eslint": "8.67.0",
    "@eslint/js": "10.0.1",
    "prettier": "3.3.3",
    "web-ext": "10.6.0",
    "selenium-webdriver": "4.25.0",
    "@types/selenium-webdriver": "4.35.6",
    "@types/chrome": "0.0.287",
    "geckodriver": "4.5.0"
  }
}
